{
  "name": "@yangyangxresearch/yang-ts-sdk",
  "version": "0.1.0",
  "description": "Official YangYang TypeScript SDK — typed clients for Studio products",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./open-guardrails": {
      "types": "./dist/open-guardrails/index.d.ts",
      "import": "./dist/open-guardrails/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "yangyang",
    "guardrails",
    "yog",
    "llm-safety"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YangYang-Research/yang-ts-sdk.git"
  },
  "homepage": "https://github.com/YangYang-Research/yang-ts-sdk",
  "dependencies": {
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
